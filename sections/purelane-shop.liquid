{{ 'purelane-sections.css' | asset_url | stylesheet_tag }}

<section class="pl-scope pl-sec" id="{{ section.id }}" data-scene="3">
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="pl-rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>

    <div class="pl-shelf">
      {%- liquid
        assign col = section.settings.collection
        assign limit = section.settings.products_to_show
      -%}
      {%- if col != blank -%}
        {%- for product in col.products limit: limit -%}
          {%- render 'purelane-product-card', product: product -%}
        {%- else -%}
          <p class="pl-lede">This collection has no products yet. Add some in the Shopify admin.</p>
        {%- endfor -%}
      {%- else -%}
        <p class="pl-lede">Select a collection in the theme editor to show products here.</p>
      {%- endif -%}
    </div>

    {%- if section.settings.view_all_url != blank -%}
      <div style="text-align:center;margin-top:24px">
        <a href="{{ section.settings.view_all_url }}" class="pl-btn pl-btn-ghost">{{ section.settings.view_all_label | default: 'View all products' }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'purelane-sections.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Purelane: Shop grid",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 30,000 homes" },
    { "type": "collection", "id": "collection", "label": "Collection to show" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 24, "step": 4, "default": 8 },
    { "type": "url", "id": "view_all_url", "label": "\"View all\" link" },
    { "type": "text", "id": "view_all_label", "label": "\"View all\" label", "default": "View all products" }
  ],
  "presets": [
    { "name": "Purelane: Shop grid" }
  ]
}
{% endschema %}
