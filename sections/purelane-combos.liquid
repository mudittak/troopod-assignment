{{ 'purelane-sections.css' | asset_url | stylesheet_tag }}

<section class="pl-scope pl-sec" id="{{ section.id }}" data-scene="3">
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="pl-rule"><i></i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg><i></i></div>
      {%- if section.settings.subheading != blank -%}<p class="pl-lede" style="margin:14px auto 0">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <div class="pl-comborail pl-rv">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p1 = block.settings.product_1
          assign p2 = block.settings.product_2
          assign p3 = block.settings.product_3
          assign bundle_price_cents = block.settings.bundle_price | times: 100
          assign line_total = 0
          if p1 != blank
            assign p1_price = p1.compare_at_price | default: p1.price
            assign line_total = line_total | plus: p1_price
          endif
          if p2 != blank
            assign p2_price = p2.compare_at_price | default: p2.price
            assign line_total = line_total | plus: p2_price
          endif
          if p3 != blank
            assign p3_price = p3.compare_at_price | default: p3.price
            assign line_total = line_total | plus: p3_price
          endif
          assign savings = line_total | minus: bundle_price_cents
        -%}
        <article class="pl-glass pl-combo" {{ block.shopify_attributes }}>
          <div class="pl-tray">
            {%- if savings > 0 -%}<span class="pl-save">You save {{ savings | money }}</span>{%- endif -%}
            {%- if block.settings.flag_label != blank -%}<span class="pl-flag">{{ block.settings.flag_label }}</span>{%- endif -%}
            <div class="pl-stack">
              {%- if p1 != blank -%}<span>{% if p1.featured_image %}{{ p1.featured_image | image_url: width: 100 | image_tag: alt: p1.title }}{% endif %}</span>{%- endif -%}
              {%- if p2 != blank -%}<span class="pl-plus" aria-hidden="true">+</span><span>{% if p2.featured_image %}{{ p2.featured_image | image_url: width: 100 | image_tag: alt: p2.title }}{% endif %}</span>{%- endif -%}
              {%- if p3 != blank -%}<span class="pl-plus" aria-hidden="true">+</span><span>{% if p3.featured_image %}{{ p3.featured_image | image_url: width: 100 | image_tag: alt: p3.title }}{% endif %}</span>{%- endif -%}
            </div>
          </div>
          <div class="pl-body">
            <h3>{{ block.settings.title }}</h3>
            <div class="pl-cnt">{{ block.settings.product_count | default: 3 }} products</div>
            <p class="pl-inc">{{ block.settings.description }}</p>
            <div class="pl-prow">
              <strong>{{ bundle_price_cents | money }}</strong>
              {%- if line_total > 0 -%}<s>{{ line_total | money }}</s>{%- endif -%}
              {%- if savings > 0 -%}<em>Save {{ savings | money }}</em>{%- endif -%}
            </div>
            <div class="pl-fine">Inclusive of all taxes · COD available</div>
            <a class="pl-btn {% if block.settings.flag_label != blank %}pl-btn-primary{% else %}pl-btn-ghost{% endif %} pl-btn-full" href="{{ block.settings.cta_url | default: '#bundles' }}">
              Shop bundle
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
            </a>
          </div>
        </article>
      {%- endfor -%}
    </div>
    <div class="pl-swipecue" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>Swipe for more combos</div>
  </div>
</section>

<script src="{{ 'purelane-sections.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Purelane: Combos",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        { "type": "text", "id": "title", "label": "Combo title", "default": "Kitchen essentials" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "product", "id": "product_1", "label": "Product 1" },
        { "type": "product", "id": "product_2", "label": "Product 2" },
        { "type": "product", "id": "product_3", "label": "Product 3 (optional)" },
        { "type": "number", "id": "product_count", "label": "Products count label", "default": 3 },
        { "type": "number", "id": "bundle_price", "label": "Bundle price (whole number, e.g. 499)", "default": 499 },
        { "type": "text", "id": "flag_label", "label": "Flag badge (e.g. \"Most popular\")" },
        { "type": "url", "id": "cta_url", "label": "\"Shop bundle\" link" }
      ]
    }
  ],
  "presets": [
    { "name": "Purelane: Combos", "blocks": [{ "type": "combo" }, { "type": "combo" }, { "type": "combo" }] }
  ]
}
{% endschema %}
