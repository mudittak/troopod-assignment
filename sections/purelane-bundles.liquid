{{ 'purelane-sections.css' | asset_url | stylesheet_tag }}

<section class="pl-scope pl-sec" id="{{ section.id }}" data-scene="3">
  <div class="pl-wrap">
    <div class="pl-glass pl-rv" style="padding:28px;margin-bottom:20px">
      <div class="pl-panel-head" style="margin-bottom:0">
        {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}<p class="pl-lede" style="margin:0 auto">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
    </div>

    <div class="pl-tiers">
      {%- for block in section.blocks -%}
        {%- liquid
          assign price_cents = block.settings.price | times: 100
          assign compare_cents = block.settings.compare_price | times: 100
        -%}
        <article class="pl-glass pl-tier pl-rv {% if block.settings.featured %}pl-best{% endif %}" {{ block.shopify_attributes }}>
          <span class="pl-tag">{{ block.settings.tag }}</span>
          <div class="pl-qty">{{ block.settings.product_count }}<small>Products</small></div>
          <div class="pl-price">
            {{ price_cents | money }}
            {%- if compare_cents > price_cents -%}<s>{{ compare_cents | money }}</s>{%- endif -%}
          </div>
          {%- if block.settings.per_product_note != blank -%}<p class="pl-lede" style="font-size:12px;max-width:none">{{ block.settings.per_product_note }}</p>{%- endif -%}
          {%- if block.settings.features != blank -%}
            {%- assign feature_lines = block.settings.features | newline_to_br | split: '<br />' -%}
            <ul>
              {%- for line in feature_lines -%}
                {%- assign line = line | strip -%}
                {%- if line != blank -%}
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                    {{ line }}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
          <a class="pl-btn {% if block.settings.featured %}pl-btn-primary{% else %}pl-btn-ghost{% endif %} pl-btn-full" href="{{ block.settings.cta_url | default: '#shop' }}">
            {{ block.settings.cta_label | default: 'Build this box' }}
          </a>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane: Bundles",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Build your bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One box. Every room." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way." }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle tier",
      "settings": [
        { "type": "text", "id": "tag", "label": "Tag", "default": "Starter" },
        { "type": "number", "id": "product_count", "label": "Number of products", "default": 2 },
        { "type": "number", "id": "price", "label": "Price", "default": 349 },
        { "type": "number", "id": "compare_price", "label": "Compare-at price (optional)", "default": 598 },
        { "type": "text", "id": "per_product_note", "label": "Small note", "default": "Flat ₹174 per product" },
        { "type": "textarea", "id": "features", "label": "Features (one per line)", "default": "Pick any two products\nFree shipping across India" },
        { "type": "checkbox", "id": "featured", "label": "Highlight as \"Most popular\"", "default": false },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "Build this box" },
        { "type": "url", "id": "cta_url", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane: Bundles",
      "blocks": [
        { "type": "tier" },
        { "type": "tier", "settings": { "tag": "Most popular", "product_count": 3, "price": 499, "compare_price": 897, "featured": true } },
        { "type": "tier", "settings": { "tag": "Whole home", "product_count": 5, "price": 799, "compare_price": 1495 } }
      ]
    }
  ]
}
{% endschema %}
